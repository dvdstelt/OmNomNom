<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>OmNomNom.AllInOne</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
      <!-- 10.2.7 to match Argus.Endpoint.Reporting; NuGet refuses the transitive upgrade otherwise. -->
      <PackageReference Include="NServiceBus" Version="10.2.7" />
    </ItemGroup>

    <ItemGroup>
      <!-- Argus reporting add-in: sibling checkout of dvdstelt/ServiceControlSpike.
           Reports each endpoint's identity, instance and handlers to the Argus control center
           over HTTP and heartbeats. Local dev wiring, not for CI. -->
      <ProjectReference Include="..\..\..\ServiceControlSpike\src\Argus.Endpoint.Reporting\Argus.Endpoint.Reporting.csproj" />
      <ProjectReference Include="..\Catalog.Endpoint\Catalog.Endpoint.csproj" />
      <ProjectReference Include="..\Checkout.Endpoint\Checkout.Endpoint.csproj" />
      <ProjectReference Include="..\Finance.Endpoint\Finance.Endpoint.csproj" />
      <ProjectReference Include="..\Marketing.Endpoint\Marketing.Endpoint.csproj" />
      <ProjectReference Include="..\PaymentInfo.Endpoint\PaymentInfo.Endpoint.csproj" />
      <ProjectReference Include="..\Shipping.Endpoint\Shipping.Endpoint.csproj" />
    </ItemGroup>

</Project>
